# =============================================================================
# Cairo Homes — environment template (safe to commit)
# Copy to Server/.env for local use. Production: set these in Railway only.
# Never put real secrets in this file.
# Domain: https://cairohomes.com
# =============================================================================

NODE_ENV=development
PORT=5000
# Supabase Postgres URI. URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.elysegyvrlslcsadpgte.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Production (Railway) example:
# NODE_ENV=production
# FRONTEND_URL=https://cairohomes.com
# ADMIN_URL=https://cairohomes.com/admin
# CORS_ORIGIN=https://cairohomes.com,https://www.cairohomes.com
# BACKEND_PUBLIC_URL=https://cairohomes.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob (optional — enable when payments go live)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com/api

RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@cairohomes.com
INQUIRY_FROM_EMAIL=Cairo Homes <info@cairohomes.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# WhatsApp Cloud API (Meta) — see Server/docs/whatsapp-meta-setup.md
# Leave blank to disable sends. Requires approved templates before live guest messages.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_BOOKING_ACCEPTED=booking_accepted
# WHATSAPP_TEMPLATE_CHECKOUT_FEEDBACK=checkout_feedback

# Required for /api/cron/* endpoints (Bearer token). Leave empty only in local if unused — production MUST set a strong secret.
CRON_SECRET=
# Partner inventory feed (/api/partners/v1/inventory). Long random secret; give partners the key, not this file.
PARTNER_INVENTORY_API_KEY=
# Outbound inventory webhooks (Cairo Homes → partner). Read-only notifications; no partner write access.
# PARTNER_WEBHOOK_URL=https://partner.example.com/webhooks/cairo-homes-inventory
# PARTNER_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional shared secret for non-admin pricing sync (admins can sync without it)
PRICING_SYNC_SECRET=

# Initial admin is created only when no admin exists. Never overwrites existing passwords.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@cairohomes.com
